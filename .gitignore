# Local runtime state.
.technical-knowledge.log
.technical-knowledge.pid
local-notes.md
__pycache__/
*.py[cod]
.pytest_cache/

# Dependency caches and build output from bundled projects.
**/.next/
**/.next-*/
**/node_modules/
**/.venv/
**/__pycache__/
**/.pytest_cache/
**/data/user/
**/data/usage/
**/data/knowledge_bases/
**/.codegraph/
**/.turbo/
**/.cache/
**/dist/
**/build/
**/*.log
**/*.pid
projects/archify/archify.zip

# The package is kept under packages/agent-foundation.
/agent_foundation/

# Third-party source checkouts used by the learning tools. They are upstream
# clones (OpenMAIC, DeepTutor, archify, mattpocock-skills), not this project's
# source, and they are far too large to track. Re-create them by cloning.
# projects/index.html and projects/README.md are authored here, so they are
# re-included below.
/projects/*
!/projects/index.html
!/projects/README.md

# The vault is the actual knowledge asset, so it is versioned: notes get
# rewritten and the history of why is worth keeping.
# Obsidian's own workspace state is noise, as is anything it caches.
/vault/.obsidian/
/vault/.trash/
.vault/

# Vendored browser libraries pulled in by install scripts, not written here.
/site/mermaid.min.js

# Large media and exports that do not belong in history.
*.mov
*.mp4
*.zip
*.dmg

# Clipped screenshots are attachments, not knowledge: 30MB of PNG would be
# stored in full on every edit. They stay on disk and are referenced by notes.
/vault/**/*.png
/vault/**/*.jpg
/vault/**/*.jpeg
/vault/**/*.pdf

# Paper full texts pulled down to write an L2 deep read. They are the
# publishers' copyrighted text, kept only as a local writing aid — the
# registry, the notes and the analyses are what get committed.
/vault/知识库管理/归档/来源/论文与项目/全文/

# Reader feedback and visit logs. This is visitor data collected at runtime,
# not knowledge: it must never be committed. The directory is created on first
# write by the server, so a fresh clone simply has no data/.
/data/
