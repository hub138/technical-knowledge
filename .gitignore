# Local runtime state.
.technical-knowledge.log
.technical-knowledge.pid
local-notes.md
__pycache__/
*.py[cod]
.pytest_cache/

# Dependency caches and build output from bundled projects.
**/.next/
**/.next-*/
**/node_modules/
**/.venv/
**/__pycache__/
**/.pytest_cache/
**/data/user/
**/data/usage/
**/data/knowledge_bases/
**/.codegraph/
**/.turbo/
**/.cache/
**/dist/
**/build/
**/*.log
**/*.pid
projects/archify/archify.zip

# The package is kept under packages/agent-foundation.
/agent_foundation/

# Third-party source checkouts used by the learning tools. They are upstream
# clones (OpenMAIC, DeepTutor, archify, mattpocock-skills), not this project's
# source, and they are far too large to track. Re-create them by cloning.
# projects/index.html and projects/README.md are authored here, so they are
# re-included below.
/projects/*
!/projects/index.html
!/projects/README.md

# The vault is the actual knowledge asset, so it is versioned: notes get
# rewritten and the history of why is worth keeping.
# Obsidian's own workspace state is noise, as is anything it caches.
/vault/.obsidian/
/vault/.trash/
.vault/

# Vendored browser libraries pulled in by install scripts, not written here.
/site/mermaid.min.js
/site/katex.min.js
/site/katex.min.css
/site/fonts/

# Large media and exports that do not belong in history.
*.mov
*.mp4
*.zip
*.dmg

# Clipped screenshots are attachments, not knowledge: 30MB of PNG would be
# stored in full on every edit. They stay on disk and are referenced by notes.
/vault/**/*.png
/vault/**/*.jpg
/vault/**/*.jpeg
/vault/**/*.pdf

# Paper full texts pulled down to write an L2 deep read. They are the
# publishers' copyrighted text, kept only as a local writing aid — the
# registry, the notes and the analyses are what get committed.
/vault/知识库管理/归档/来源/论文与项目/全文/

# Reader feedback and visit logs. This is visitor data collected at runtime,
# not knowledge: it must never be committed — they carry IPs, agents and
# contact info. The directory is created on first write by the server, so a
# fresh clone simply has no data/.
# 忽略 data/ 的内容而不是目录本身——git 规定被排除目录的子项无法用 !
# 重新收录，收藏数据要跟着仓库走，必须留出反选的余地。
/data/*
# 收藏是读者亲手挑的内容（只有文章快照与收藏时间，无任何访客身份信息），
# 跟着仓库走：换机器、重新 clone，收藏夹不空。
!/data/favorites.json

# AI 改版过程的 .bak 快照与设计手册：工作现场备份，不是源码，历史由 git 管。
*.bak
*.bak-*
*.bak1
*.bak2
*.bak2
*.bak3
*.bak4
*.bak5
*.bak6
*.bak7
*.bak8
*.bak9
*.bak-misref
*.retired
*.corrupted-*
vault.bak-*/
/.design/
/audit-shots/
/data/feedback.jsonl.bak-test

# 已并入知识库文章的词汇页残壳（重定向页，保留在盘上避免外链 404）。
/vocab/

# 点击取证用的临时验证页（页内自标"勿提交"）。
/site/do-toggle.html
/site/toggle-state.html
/site/verify-wrap.html
/site/insights.html.bak

# 定时任务运行日志（crontab 追加写入，运行时产物）。
/logs/

# 全量优化的认领锁：进行中的临时状态不入库（半途中断会留下过期锁）。
# 完成状态写在文章 frontmatter 的 editorial_pass / editorial_at / editorial_by 里，
# 那三个字段跟着文章走，是唯一的事实源。
/.editorial/
.agent/tmp/
.concurrent-guard/

.scratch/

# 内部名单/黑名单：不得随仓库公开（check_skill_drift 的敏感文件守卫要求）
scripts/internal_names.txt
**/internal_names.txt

# 中间结果目录（配图/验收过程的临时产物）
.work-img/

# 企微通知去重状态（本地运行产物）与环境变量文件（webhook key 等只存本地，不进仓库）
data/.wecom-notify-state.json
data/.paper-scout-state.json
.env
*.env

# 私享内容提示词（含读者个人项目背景与口径，只放主仓库非 git 目录；本条防误移入）
scripts/paper-scout-prompt.md

# 私享雷达脚本：PROJECT_ROOTS 写死本机 mr_six 项目路径，借鉴点服务个人项目，永不入 GitHub
scripts/private_paper_scout.py

# 内部工具链脚本：依赖部署机本地的内部平台（模型池、agent CLI），公开环境
# 装不上这些依赖，脚本留在本地与本机 crontab 里跑，不入 GitHub
scripts/score_papers.py
scripts/run_agent_task.py
scripts/review_by_llm.py
scripts/verify_review_fixes.py
scripts/score_papers_prompt.md
score_papers_prompt.md
score_result.json

# 本地工作现场：评审中间稿、认领锁、基线快照与临时目录，都不是源码
after-*.md
before-*.md
seq-125-*
.Trash-0/
.before6/
.claim6.txt
.edit-tmp/
.review-out*/
.verify_scratch/
.work/
.work-10/
.work-10-baseline.py
/.review6.log
/.bak6/

# AI 周报任务提示词：内含写作规范路径与站长个人口径，只留本地
scripts/radar_weekly_prompt.md

# 指向本地聚合层主副本的符号链接：目标是本机绝对路径，公开 clone 无效且泄
# 露机器目录结构，永不入 GitHub
.knowledge-skills/knowledge-governor

# 翻译桥接模块：包装部署机本地的模型池，公开环境没有这层依赖。
# 缺了它 server.py 捕获 ImportError，翻译自动降级为显示英文原题
site/translate_bridge.py
